{
  "id": null,
  "uid": "app-alert-overview",
  "title": "App Alert Overview",
  "description": "앱 헬스 상태 및 리소스 알람 전용 대시보드",
  "tags": ["app", "alert", "recovery"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "annotations": { "list": [] },
  "templating": { "list": [] },

  "panels": [

    {
      "id": 1,
      "title": "App Scrape Status",
      "description": "up == 0 이면 Actuator 무응답. Lambda soft recovery 트리거 대상.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "afkfasa4h1kowe" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red",   "index": 0 },
                "1": { "text": "UP",   "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1    }
            ]
          },
          "color": { "mode": "thresholds" },
          "noValue": "No Data"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "afkfasa4h1kowe" },
          "expr": "up{job=\"app-actuator\"}",
          "legendFormat": "{{instance_name}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "title": "Redis Health",
      "description": "0 이면 Redis 연결 끊김. relay fallback 전환 여부 확인.",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "afkfasa4h1kowe" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red",   "index": 0 },
                "1": { "text": "UP",   "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1    }
            ]
          },
          "color": { "mode": "thresholds" },
          "noValue": "No Data"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "afkfasa4h1kowe" },
          "expr": "realtime_health_redis{job=\"app-actuator\"}",
          "legendFormat": "{{instance_name}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "title": "Kafka Health",
      "description": "0 이면 Kafka 연결 끊김. outbox 저장 및 재발행 상태 확인.",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "afkfasa4h1kowe" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red",   "index": 0 },
                "1": { "text": "UP",   "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1    }
            ]
          },
          "color": { "mode": "thresholds" },
          "noValue": "No Data"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "afkfasa4h1kowe" },
          "expr": "realtime_health_kafka{job=\"app-actuator\"}",
          "legendFormat": "{{instance_name}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "title": "CPU Usage",
      "description": "> 70% 2분 지속 시 Lambda → ASG scale-out",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "afkfasa4h1kowe" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizWidth": 75,
        "minVizHeight": 75,
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.7  },
              { "color": "red",    "value": 0.9  }
            ]
          },
          "color": { "mode": "thresholds" },
          "noValue": "No Data"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "afkfasa4h1kowe" },
          "expr": "process_cpu_usage{job=\"app-actuator\"}",
          "legendFormat": "{{instance_name}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "title": "Heap Usage",
      "description": "> 85% scale-out | > 95% Lambda → SSM docker restart (OOM 방지)",
      "type": "gauge",
      "gridPos": { "x": 8, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "afkfasa4h1kowe" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizWidth": 75,
        "minVizHeight": 75,
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.85 },
              { "color": "red",    "value": 0.95 }
            ]
          },
          "color": { "mode": "thresholds" },
          "noValue": "No Data"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "afkfasa4h1kowe" },
          "expr": "jvm_memory_used_bytes{job=\"app-actuator\", area=\"heap\"} / jvm_memory_max_bytes{job=\"app-actuator\", area=\"heap\"}",
          "legendFormat": "{{instance_name}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "title": "HikariCP Usage",
      "description": "> 80% 경고 | pending > 0 이면 thread starvation 위험",
      "type": "gauge",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "afkfasa4h1kowe" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizWidth": 75,
        "minVizHeight": 75,
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.8  },
              { "color": "red",    "value": 0.95 }
            ]
          },
          "color": { "mode": "thresholds" },
          "noValue": "No Data"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "afkfasa4h1kowe" },
          "expr": "hikaricp_connections_active{job=\"app-actuator\"} / hikaricp_connections_max{job=\"app-actuator\"}",
          "legendFormat": "{{instance_name}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },

    {
      "id": 7,
      "title": "GC Pause Rate",
      "description": "> 0.3s/s 지속 시 Heap/allocation 분석 필요",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "afkfasa4h1kowe" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.1  },
              { "color": "red",    "value": 0.3  }
            ]
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "afkfasa4h1kowe" },
          "expr": "rate(jvm_gc_pause_seconds_sum{job=\"app-actuator\"}[1m])",
          "legendFormat": "{{instance_name}} {{cause}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 8,
      "title": "HikariCP Pending",
      "description": "pending > 0 이면 connection 대기 발생 → thread block 위험",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "afkfasa4h1kowe" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1    }
            ]
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "afkfasa4h1kowe" },
          "expr": "hikaricp_connections_pending{job=\"app-actuator\"}",
          "legendFormat": "{{instance_name}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 9,
      "title": "Firing Alerts",
      "type": "alertlist",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "options": {
        "alertInstanceLabelFilter": "",
        "alertName": "",
        "dashboardAlerts": false,
        "groupBy": [],
        "groupMode": "default",
        "maxItems": 20,
        "nameFilter": "",
        "stateFilter": {
          "error": true,
          "firing": true,
          "noData": false,
          "normal": false,
          "pending": true
        },
        "sortOrder": 1,
        "viewMode": "list"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }

  ]
}
